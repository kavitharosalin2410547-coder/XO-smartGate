{
  "name": "smartgate",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first garage manager (cars, number plates, wash jobs) built with Next.js as a PWA",
  "scripts": {
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-ocr-assets.mjs && next build && node scripts/inject-precache.mjs",
    "start": "serve out -l 3000",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "^14.2.0",
    "typescript": "^7.0.2"
  }
}
